# Copy to .env.local and fill in. Never commit .env.local.
# With none of these set, the app runs on local stand-ins (a JSON file for the
# database and sign-in, a demo AI writer, emails written to .data/outbox.jsonl).
# Each service switches on when its keys are present. See replica/backend.md.

# --- App ---------------------------------------------------------------------
# Public address, used in email links and Stripe redirects. Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Placeholder until /replica-brand.
NEXT_PUBLIC_PRODUCT_NAME=
# Signs the 60-second print links used for PDF export. Any long random string.
# Required in production. Generate one: openssl rand -hex 32
PRINT_TOKEN_SECRET=
# Keys the hashes used for rate limits (falls back to PRINT_TOKEN_SECRET).
RATE_LIMIT_SALT=
# Chrome used to print PDFs locally (auto-detected on macOS/Linux if unset).
CHROME_PATH=

# --- Supabase (database + sign-in) --------------------------------------------
# Project Settings → API. The service role key bypasses row level security:
# server only, never in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (Session pooler). Used only by
# `npm run db:migrate`, not by the app.
DATABASE_URL=
# OAuth providers you've switched on in Supabase (Authentication → Providers),
# comma-separated: google, apple. Leave empty to hide the buttons.
AUTH_OAUTH_PROVIDERS=

# --- AI (Vercel AI Gateway) ----------------------------------------------------
# On Vercel the gateway uses the project's OIDC token; locally, create a key in
# the Vercel dashboard → AI Gateway → API keys.
AI_GATEWAY_API_KEY=
# Optional overrides (gateway model ids).
AI_MODEL_FAST=anthropic/claude-haiku-4.5
AI_MODEL_STRONG=anthropic/claude-sonnet-5.5

# --- Stripe (test mode until /replica-deploy) ----------------------------------
# Developers → API keys (sk_test_...). Webhook secret from the endpoint for
# /api/webhooks/stripe, or from `stripe listen` locally (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Product catalogue → the price ids (price_...) for each plan.
STRIPE_PRICE_MONTH=
STRIPE_PRICE_QUARTER=
STRIPE_PRICE_LIFETIME=

# --- Email (Resend) ------------------------------------------------------------
# For the emails the app sends itself (payment failed). Supabase Auth's emails
# go through Resend too, set up as SMTP in the Supabase dashboard.
RESEND_API_KEY=
# A sender on your verified domain, e.g. Resume Builder <hello@mail.example.com>
EMAIL_FROM=

# --- Jobs ----------------------------------------------------------------------
# Vercel Cron sends this as a bearer token. Generate one: openssl rand -hex 32
CRON_SECRET=
