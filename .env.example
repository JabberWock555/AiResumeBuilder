# Copy to .env.local. Values are set in /replica-backend and /replica-deploy.

# Chrome used to print PDFs locally (auto-detected on macOS/Linux if unset)
CHROME_PATH=

# Signs the 60-second print links used for PDF export (required in production)
PRINT_TOKEN_SECRET=

# Filled in by /replica-backend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_QUARTER=
STRIPE_PRICE_LIFETIME=
NEXT_PUBLIC_APP_URL=
CRON_SECRET=
