{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-webhook-test",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "STRIPE_WEBHOOK_SECRET=whsec_local_webhook_check_only",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "npm run build && NEXT_PUBLIC_APP_URL=http://localhost:3200 PRINT_TOKEN_SECRET=local-prod-check-only STRIPE_WEBHOOK_SECRET=whsec_local_webhook_check_only npx next start -p 3200"
      ],
      "port": 3200
    }
  ]
}
